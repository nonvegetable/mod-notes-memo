{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mod-notes-memo",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "View Mod Notes",
        "description": "View all private mod notes for this post.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/view-mod-notes"
      },
      {
        "label": "Add Mod Note",
        "description": "Add a private note for your mod team about this post.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-mod-note"
      }
    ]
  },
  "forms": {
    "addModNote": "/internal/form/add-mod-note-submit",
    "viewModNotes": "/internal/form/view-mod-notes-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "dev": {
    "subreddit": "mod_notes_memo_dev"
  }
}